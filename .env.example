# ==============================================================================
# VELTO FINANCE - ENVIRONMENT VARIABLES (TiDB Cloud & Google OAuth)
# Masukkan variabel ini di Vercel Dashboard: Project Settings -> Environment Variables
# ==============================================================================

# 1. TiDB Cloud Serverless Connection (Bisa pakai DATABASE_URL atau terpisah)
DATABASE_URL=mysql://<user>:<password>@<host>:4000/<database>?ssl={"rejectUnauthorized":true}

# Atau konfigurasi terpisah:
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=xxxxxx.root
TIDB_PASSWORD=your_tidb_password_here
TIDB_DATABASE=velto

# 2. Google OAuth 2.0 (Dari Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# 3. Akun Pemilik Utama (Owner)
OWNER_EMAIL=andrasyahdand@gmail.com

# 4. JWT Secret untuk enkripsi sesi login
JWT_SECRET=velto_super_secure_jwt_secret_key_2026
